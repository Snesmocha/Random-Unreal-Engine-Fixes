<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Switch to net10.0 (current LTS as of late 2025) if/when you're ready -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>UnrealBuildTool</RootNamespace>
    <AssemblyName>UnrealBuildTool</AssemblyName>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RunPostBuildEvent>OnOutputUpdated</RunPostBuildEvent>
    <OutputPath>..\..\..\Binaries\DotNET\UnrealBuildTool\</OutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>..\..\..\Binaries\DotNET\UnrealBuildTool\UnrealBuildTool.xml</DocumentationFile>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>
    </NoWarn>

    <!-- Default globbing would pull in every Platform\* folder unconditionally,
         ignoring the Exists() gates below, so it's still disabled and every
         inclusion (including the platform ones) is done via explicit globs. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>

    <!-- Properties\AssemblyInfo.cs already exists checked in and defines these
         attributes; the SDK's own auto-generated AssemblyInfo.cs in obj\ would
         define them a second time (CS0579 duplicate-attribute errors). -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == '' Or '$(Configuration)' == 'Development' ">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <ErrorReport>prompt</ErrorReport>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
    <DebugType>pdbonly</DebugType>
    <ErrorReport>prompt</ErrorReport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <Windows10SdkPath>$(Registry:HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\Microsoft\Microsoft SDKs\Windows\v10.0@InstallationFolder)</Windows10SdkPath>
    <Windows10SdkLatestVersion>$(Registry:HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\Microsoft\Microsoft SDKs\Windows\v10.0@ProductVersion)</Windows10SdkLatestVersion>
  </PropertyGroup>

  <!--
    System, System.Core, System.Data, System.Xml, System.Xml.Linq are implicit
    in the SDK now. System.Management / System.ServiceProcess need NuGet on
    .NET Core+. System.Web.Extensions has no equivalent — port any usages
    (e.g. JavaScriptSerializer) to System.Text.Json.
  -->
  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Ionic.Zip.Reduced">
      <HintPath>..\..\..\Binaries\DotNET\Ionic.Zip.Reduced.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Setup.Configuration.Interop" Condition="'$(OS)' == 'Windows_NT'">
      <HintPath>..\..\..\Binaries\ThirdParty\VisualStudio\Microsoft.VisualStudio.Setup.Configuration.Interop.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <!-- Core folders: every .cs file under these directories is always compiled. -->
  <ItemGroup>
    <Compile Include="Configuration\**\*.cs" />
    <Compile Include="Executors\**\*.cs" />
    <Compile Include="Modes\**\*.cs" />
    <Compile Include="ProjectFiles\**\*.cs" />
    <!-- System\AggregateParsedTimingInfo.cs and System\ParseMsvcTimingInfo.cs are
         stray duplicates of the real Modes\AggregateParsedTimingInfo.cs and
         Modes\ParseMsvcTimingInfo.cs (the ones the original hand-written list
         referenced) — excluded here to avoid CS0101/CS0579/CS0111 duplicate-
         definition errors. Worth deleting the stray copies from disk too. -->
    <Compile Include="System\**\*.cs" Exclude="System\AggregateParsedTimingInfo.cs;System\ParseMsvcTimingInfo.cs" />
    <Compile Include="Properties\**\*.cs" />
    <!-- AppleToolChain.cs is only relevant when Mac is present; carved out here
         and re-added in the Mac Choose/When block below. -->
    <Compile Include="ToolChain\**\*.cs" Exclude="ToolChain\AppleToolChain.cs" />
    <Compile Include="UnrealBuildTool.cs" />
    <Compile Include="..\DotNETCommon\MetaData.cs">
      <Link>Properties\MetaData.cs</Link>
    </Compile>
  </ItemGroup>

  <!-- Platform\Windows and the two always-built IOS files are unconditional;
       the rest of Platform\IOS is gated below along with the other platforms. -->
  <ItemGroup>
    <Compile Include="Platform\Windows\**\*.cs" />
    <Compile Include="Platform\IOS\IOSPostBuildSyncMode.cs" />
    <Compile Include="Platform\IOS\MobileProvisionContents.cs" />
  </ItemGroup>

  <Choose>
    <When Condition="Exists('Platform\XboxOne\UEBuildXboxOne.cs')">
      <ItemGroup>
        <Compile Include="Platform\XboxOne\**\*.cs" />
      </ItemGroup>
    </When>
  </Choose>
  <Choose>
    <When Condition="Exists('Platform\Switch\UEBuildSwitch.cs')">
      <ItemGroup>
        <Compile Include="Platform\Switch\**\*.cs" />
      </ItemGroup>
    </When>
  </Choose>
  <Choose>
    <When Condition="Exists('Platform\PS4\UEBuildPS4.cs')">
      <ItemGroup>
        <Compile Include="Platform\PS4\**\*.cs" />
      </ItemGroup>
    </When>
  </Choose>
  <Choose>
    <When Condition="Exists('Platform\Mac\UEBuildMac.cs')">
      <ItemGroup>
        <Compile Include="Platform\Mac\**\*.cs" />
        <Compile Include="ToolChain\AppleToolChain.cs" />
      </ItemGroup>
    </When>
  </Choose>
  <Choose>
    <When Condition="Exists('Platform\Quail\UEBuildQuail.cs')">
      <ItemGroup>
        <Compile Include="Platform\Quail\**\*.cs" />
      </ItemGroup>
    </When>
  </Choose>
  <Choose>
    <When Condition="Exists('Platform\TVOS\UEBuildTVOS.cs')">
      <ItemGroup>
        <Compile Include="Platform\TVOS\**\*.cs" />
      </ItemGroup>
    </When>
  </Choose>
  <Choose>
    <When Condition="Exists('Platform\Android\UEBuildAndroid.cs')">
      <ItemGroup>
        <Compile Include="Platform\Android\**\*.cs" />
      </ItemGroup>
    </When>
  </Choose>
  <Choose>
    <When Condition="Exists('Platform\IOS\UEBuildIOS.cs')">
      <ItemGroup>
        <Compile Include="Platform\IOS\**\*.cs" Exclude="Platform\IOS\IOSPostBuildSyncMode.cs;Platform\IOS\MobileProvisionContents.cs" />
      </ItemGroup>
    </When>
  </Choose>
  <Choose>
    <When Condition="Exists('Platform\Linux\UEBuildLinux.cs')">
      <ItemGroup>
        <Compile Include="Platform\Linux\**\*.cs" />
      </ItemGroup>
    </When>
  </Choose>

  <ItemGroup>
    <None Include="app.config" />
    <None Include="app.manifest" />
  </ItemGroup>

  <!-- Glob all platform extensions' UnrealBuildTool source files. RecursiveDir
       doesn't work reliably outside Windows, so FullPath + Regex derives the
       platform name for the Link, same approach as the original project. -->
  <ItemGroup>
    <Compile Include="../../../Platforms/*/Source/Programs/UnrealBuildTool/**/*.cs">
      <Link>Platform/$([System.Text.RegularExpressions.Regex]::Replace(%(FullPath), '^(.*[\\/]Platforms[\\/])(.+?)[\\/](.*)$', '$2'))/%(Filename)%(Extension)</Link>
    </Compile>

    <Compile Include="../../../Restricted/*/Platforms/*/Source/Programs/UnrealBuildTool/**/*.cs">
      <Link>Platform/$([System.Text.RegularExpressions.Regex]::Replace(%(FullPath), '^(.*[\\/]Platforms[\\/])(.+?)[\\/](.*)$', '$2'))/%(Filename)%(Extension)</Link>
    </Compile>

    <Compile Include="../../../Restricted/*/Source/Programs/UnrealBuildTool/**/*.cs">
      <Link>$([System.Text.RegularExpressions.Regex]::Replace(%(FullPath), '^.+?[\\/]UnrealBuildTool[\\/]', ''))</Link>
    </Compile>
  </ItemGroup>

  <!-- To modify your build process, add your task inside one of the targets below.
  <Target Name="BeforeBuild">
  </Target>
  <Target Name="AfterBuild">
  </Target>
  -->

  <ItemGroup>
    <ProjectReference Include="..\DotNETCommon\DotNETUtilities\DotNETUtilities.csproj" />
  </ItemGroup>

</Project>